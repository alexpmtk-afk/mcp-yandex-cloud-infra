FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
RUN useradd --system --uid 10001 telegrammedia && chown -R telegrammedia:telegrammedia /app
USER telegrammedia

EXPOSE 8080
CMD ["python", "-m", "app.media_serverless_bootstrap"]
