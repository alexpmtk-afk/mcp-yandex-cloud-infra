# Telegram Reader REMOTE runtime example.
# Production secrets live in /opt/mcp/secrets/telegram/runtime.env.
# Never commit real values.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Use either a durable session path or TELEGRAM_SESSION_STRING as configured for the runtime.
TELEGRAM_SESSION_PATH=/opt/mcp/data/telegram/telegram_news
TELEGRAM_SESSION_STRING=

TELEGRAM_DATABASE_PATH=/opt/mcp/data/telegram/telegram.db
TELEGRAM_WHITELIST_PATH=/opt/mcp/data/telegram/allowed_chats.yaml
TELEGRAM_MEDIA_PATH=/opt/mcp/data/telegram/media

# Optional transport. Leave empty for direct MTProto when no relay/proxy is required.
TELEGRAM_PROXY_TYPE=
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_WS_RELAY_URL=
TELEGRAM_WS_RELAY_TOKEN=
TELEGRAM_WS_RELAY_LOCAL_PORT=18888

# Reader/MCP authentication and manager authentication.
READER_API_TOKEN=
MANAGE_BROWSER_KEY=
MANAGE_TOKEN_SHA256=

# Background collector.
COLLECTOR_ENABLED=true
COLLECT_INTERVAL_SECONDS=60
COLLECT_BOOTSTRAP_LIMIT=200

# REMOTE bind. External browser access is provided by Tailscale Serve, not by a public bind.
HOST=127.0.0.1
PORT=8081

# Optional media storage. Leave TELEGRAM_MEDIA_BUCKET empty when Yandex Object Storage is not used.
TELEGRAM_MEDIA_BUCKET=
TELEGRAM_MEDIA_S3_ENDPOINT=https://storage.yandexcloud.net
TELEGRAM_MEDIA_PREFIX=telegram-media
TELEGRAM_MEDIA_URL_TTL=7200
TELEGRAM_PUBLIC_BASE_URL=
TELEGRAM_MEDIA_LINK_SECRET=
