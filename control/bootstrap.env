# Machine-readable bootstrap gate for GitHub ↔ Yandex Cloud automation.
# Do not set YC_OIDC_AUTH=PASS until the yandex-auth-preflight workflow succeeds.

GITHUB_REPOSITORY=PASS
TERRAFORM_STATIC_CHECK=PASS
YANDEX_CLOUD_ACCOUNT=USER_CONFIRMED
YC_WIF=PASS
YC_SERVICE_ACCOUNT=PASS
YC_FEDERATED_CREDENTIAL=PASS
YC_OIDC_AUTH=PENDING
YC_CLOUD_MUTATIONS=BLOCKED

# Current blocker (2026-08-28): GitHub repositories created after 2026-07-15
# issue immutable OIDC subjects containing owner/repository numeric IDs.
# Yandex token exchange returns invalid_client / no matching federated credentials
# even when its federated credential is configured with the exact emitted subject.
# Until OIDC is proven or an explicitly approved fallback credential is installed,
# cloud mutations remain BLOCKED.

# Important invariant:
# mcp-test and all normal infrastructure MUST be created automatically
# only after authenticated GitHub -> Yandex access is proven. They must not be
# created manually during bootstrap.
