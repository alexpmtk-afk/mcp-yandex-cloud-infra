# Machine-readable bootstrap gate for GitHub ↔ Yandex Cloud automation.

GITHUB_REPOSITORY=PASS
TERRAFORM_STATIC_CHECK=PASS
YANDEX_CLOUD_ACCOUNT=USER_CONFIRMED
YC_WIF=PASS
YC_SERVICE_ACCOUNT=PASS
YC_FEDERATED_CREDENTIAL=PASS
YC_OIDC_AUTH=PENDING
YC_AUTHORIZED_KEY_AUTH=PASS
YC_GITHUB_TO_YANDEX_AUTH=PASS
YC_CLOUD_MUTATIONS=READY

# OIDC remains pending because the current GitHub immutable subject format is not
# accepted by the configured Yandex federation. The approved fallback uses the
# repository secret YC_SERVICE_ACCOUNT_KEY_JSON with an authorized service-account
# key. The preflight workflow has proven end-to-end authentication and read access
# to cloud-alexpmtk.

# Important invariant:
# mcp-test and all normal infrastructure are created automatically from GitHub
# only after authenticated GitHub -> Yandex access is proven. Manual bootstrap
# resource creation is no longer required.
